# Copier vers .env.local (gitignoré) et remplir depuis le dashboard Supabase
# Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Uniquement pour scripts/smoke.ts (jamais utilisé par le front)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-3.pooler.supabase.com:5432/postgres
# Recommandé sur le hosted : contourne rate-limit / validation email du smoke
SUPABASE_SERVICE_ROLE_KEY=
