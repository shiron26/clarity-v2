# Copier vers .env.local (gitignoré) et remplir depuis le dashboard Supabase
# Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Confort de dev : rejoue l'onboarding à chaque chargement (onboarded_at forcé à
# null côté front). Ignoré partout ailleurs qu'en `npm run dev`.
# VITE_FORCE_ONBOARDING=1

# Notifications « Ma journée » : clé PUBLIQUE VAPID (la privée ne va que dans les
# secrets de l'Edge Function send-digests). Paire générée par :
#   npx web-push@3.6.7 generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=

# Uniquement pour scripts/smoke.ts (jamais utilisé par le front)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-3.pooler.supabase.com:5432/postgres
# Recommandé sur le hosted : contourne rate-limit / validation email du smoke
SUPABASE_SERVICE_ROLE_KEY=
