{
  "name": "clarity",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:migration": "supabase migration new",
    "db:push": "supabase db push",
    "db:push:dry": "supabase db push --dry-run",
    "db:status": "supabase migration list --linked",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "db:types:local": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "db:snapshot": "supabase db dump --linked --schema public,private -f supabase/schema.sql",
    "smoke": "tsx scripts/smoke.ts",
    "seed:dev": "tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/sora": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "supabase": "^2.114.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
