{
  "permissions": {
    "deny": [
      "Bash(npm run smoke)",
      "Bash(npm run db:push)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase link:*)",
      "Bash(npx supabase unlink:*)",
      "Bash(npx supabase migration repair:*)",
      "Read(./.env.local)",
      "Edit(./.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-hosted-supabase.sh\"",
            "statusMessage": "Vérification de la cible base…",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
